{
  "name": "@xumoses/sentry-taro",
  "version": "0.1.0-rc.2",
  "description": "Sentry monitoring and opt-in session replay for Taro 4.2 React mini programs",
  "license": "MIT",
  "author": "xumoses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xumoses/sentry-taro.git"
  },
  "homepage": "https://github.com/xumoses/sentry-taro",
  "bugs": {
    "url": "https://github.com/xumoses/sentry-taro/issues"
  },
  "type": "commonjs",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./react": {
      "types": "./dist/types/src/replay/react/index.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs.js"
    },
    "./react/root": {
      "types": "./dist/types/src/replay/react/root.d.ts",
      "import": "./dist/react-root.mjs",
      "require": "./dist/react-root.cjs.js"
    },
    "./taro/lifecycle": {
      "types": "./dist/types/src/replay/taro/lifecycle.d.ts",
      "import": "./dist/taro-lifecycle.mjs",
      "require": "./dist/taro-lifecycle.cjs.js"
    },
    "./worker": "./dist/worker/replay-compression.js",
    "./devtools/server": "./dist/devtools/server.cjs",
    "./package.json": "./package.json",
    "./taro-plugin": {
      "types": "./dist/types/src/taro-plugin/index.d.ts",
      "import": "./dist/taro-plugin/index.mjs",
      "require": "./dist/taro-plugin/index.cjs.js"
    }
  },
  "bin": {
    "sentry-taro-viewer": "./dist/devtools/server.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "rc",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vp test run",
    "test:sdk": "vp test run --project sdk",
    "test:sdk:coverage": "vp test run --project sdk --coverage",
    "test:replay": "vp test run --project replay",
    "test:release": "node --test scripts/*.test.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sdk.json",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "build": "node scripts/build.cjs",
    "build:main": "vp pack",
    "build:types": "tsc -p tsconfig.build.json",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:consumer": "node scripts/verify-consumer.cjs",
    "verify:bundles": "node scripts/verify-bundles.cjs",
    "release:prepare": "node scripts/prepare-release.cjs",
    "release:version": "node scripts/release-version.cjs",
    "release:check": "node scripts/release-check.cjs",
    "prepack": "vp run build && vp run verify:package",
    "prepublishOnly": "vp check && vp run typecheck && vp test run && vp run test:release && vp run release:check",
    "test:taro-plugin": "vp test run --project taro-plugin",
    "test:invariants": "vp test run --project invariants",
    "website:dev": "vitepress dev website",
    "website:build": "vitepress build website",
    "website:preview": "vitepress preview website"
  },
  "dependencies": {
    "@sentry/core": "10.76.2",
    "fflate": "0.8.2"
  },
  "peerDependencies": {
    "@tarojs/runtime": "~4.2.0",
    "@tarojs/taro": "~4.2.0",
    "react": "^18.0.0",
    "@sentry/cli": "^3.6.2"
  },
  "peerDependenciesMeta": {
    "@tarojs/runtime": {
      "optional": true
    },
    "@tarojs/taro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@sentry/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@sentry/cli": "3.6.2",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@types/adm-zip": "0.5.7",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.2",
    "@types/react": "18.3.31",
    "@vitest/coverage-v8": "5.0.4",
    "acorn": "8.19.0",
    "adm-zip": "0.6.0",
    "picomatch": "4.0.3",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.1",
    "postcss-value-parser": "4.2.0",
    "react": "18.3.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "vitepress": "2.0.0-alpha.20",
    "webpack-sources": "3.3.3",
    "wrangler": "4.131.1"
  }
}
